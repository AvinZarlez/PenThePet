{
  "name": "penthepet",
  "version": "1.0.0",
  "description": "Pen the Pet: A logic puzzle game about fencing in your pet",
  "main": "js/main.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint js/**/*.js test/**/*.js scripts/**/*.js",
    "lint:fix": "eslint js/**/*.js test/**/*.js scripts/**/*.js --fix",
    "generate-maps": "node scripts/generate-maps.js"
  },
  "keywords": [
    "game",
    "puzzle",
    "logic",
    "browser"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/main.js",
      "!js/config.js",
      "!js/Game.js",
      "!js/tileTypes.js",
      "!js/LevelEditor.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 75,
        "lines": 70,
        "statements": 70
      }
    },
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ]
  }
}
