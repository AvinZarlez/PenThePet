{
  "name": "penthepet",
  "version": "1.0.0",
  "description": "Pen the Pet: A logic puzzle game about fencing in your pet",
  "main": "js/main.js",
  "scripts": {
    "test": "jest --coverage",
    "test:webapp": "jest --testPathPatterns=test/webapp/",
    "test:generation": "jest --testPathPatterns=test/generation/",
    "test:watch": "jest --watch",
    "lint": "eslint js/**/*.js test/**/*.js scripts/**/*.js",
    "lint:fix": "eslint js/**/*.js test/**/*.js scripts/**/*.js --fix",
    "lint:python": "ruff check scripts/solver/",
    "lint:python:fix": "ruff check --fix scripts/solver/",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:markdown:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "lint:yaml": "yamllint .github/ .yamllint.yml",
    "lint:all": "npm run lint && npm run lint:python && npm run lint:markdown && npm run lint:yaml",
    "generate-maps": "node scripts/generate-map.js"
  },
  "keywords": [
    "game",
    "puzzle",
    "logic",
    "browser"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "markdownlint-cli2": "^0.21.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/main.js",
      "!js/config.js",
      "!js/Game.js",
      "!js/tileTypes.js",
      "!js/firebase-config.js",
      "!js/CloudSync.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 75,
        "lines": 70,
        "statements": 70
      }
    },
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ]
  }
}
