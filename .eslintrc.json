{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "indent": ["error", 4],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single", { "avoidEscape": true }],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off"
  },
  "globals": {
    "CONFIG": "readonly",
    "CONSTANTS": "readonly",
    "TILE_TYPES": "readonly",
    "getTileType": "readonly",
    "Grid": "readonly",
    "Game": "readonly",
    "MapGenerator": "readonly",
    "MILPSolver": "readonly",
    "PathfindingUtils": "readonly",
    "getRandomWord": "readonly",
    "WORD_LIST": "readonly"
  }
}
